def checkPair (p : Interval × Row) : Bool := checkPositive p.1 p.2

noncomputable def band0Pairs : List (Interval × Row) :=
  Band0Chunk00.pairs ++
    Band0Chunk01.pairs

theorem band0Checks_true : band0Pairs.all checkPair = true := by
  have h00 : Band0Chunk00.pairs.all checkPair = true := by
    change Band0Chunk00.pairs.all (fun p => checkPositive p.1 p.2) = true
    simpa only [Band0Chunk00.checks] using Band0Chunk00.checks_true
  have h01 : Band0Chunk01.pairs.all checkPair = true := by
    change Band0Chunk01.pairs.all (fun p => checkPositive p.1 p.2) = true
    simpa only [Band0Chunk01.checks] using Band0Chunk01.checks_true
  simpa only [band0Pairs, List.all_append, h00, h01, Bool.and_self]

