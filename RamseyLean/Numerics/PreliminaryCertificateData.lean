theorem exists_checked_of_map_fst
    {pairs : List (Interval × Row)} {inputs : List Interval}
    (hMap : pairs.map Prod.fst = inputs)
    (hChecks : pairs.all checkPair = true) {I : Interval} (hI : I ∈ inputs) :
    ∃ row, checkPositive I row = true := by
  have hMapMem : I ∈ pairs.map Prod.fst := by
    rw [hMap]
    exact hI
  rcases List.mem_map.mp hMapMem with ⟨p, hp, hfst⟩
  rcases p with ⟨J, row⟩
  simp only at hfst
  subst J
  refine ⟨row, ?_⟩
  have h := (List.all_eq_true.mp hChecks) (I, row) hp
  simpa only [checkPair] using h

def band0Inputs : List Interval :=
  List.range (25 + 1) |>.map (affineCell (3 * scale / 1000) (scale / 10) 25)

set_option maxHeartbeats 0 in
set_option maxRecDepth 100000 in
theorem band0Map_fst : band0Pairs.map Prod.fst = band0Inputs := by decide

theorem exists_checked_band0 (k : ℕ) (hk : k ≤ 25) :
    ∃ row, checkPositive (affineCell (3 * scale / 1000) (scale / 10) 25 k) row = true := by
  have hklt : k < 25 + 1 := by omega
  have hmemRange : k ∈ List.range (25 + 1) := List.mem_range.mpr hklt
  have hmem : affineCell (3 * scale / 1000) (scale / 10) 25 k ∈ band0Inputs :=
    List.mem_map.mpr ⟨k, hmemRange, rfl⟩
  exact exists_checked_of_map_fst band0Map_fst band0Checks_true hmem

