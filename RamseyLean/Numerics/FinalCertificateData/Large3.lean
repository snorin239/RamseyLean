theorem exists_checked_large3 (k : ℕ) (hk : k < 4000) :
    ∃ d : LargeData, d.input = uniformCell (600000000000) (100000000) k ∧
      largeCheck .threeFifthsOne d = true := by
  have hmemRange : k ∈ List.range 4000 := List.mem_range.mpr hk
  have hmem : uniformCell (600000000000) (100000000) k ∈ large3Inputs :=
    List.mem_map.mpr ⟨k, hmemRange, rfl⟩
  rcases exists_of_map_fst large3Map_fst large3Checks_true hmem with
    ⟨d, hd⟩
  simp only [largePairCheck, intervalEq, Bool.and_eq_true,
    decide_eq_true_eq] at hd
  exact ⟨d, hd.1.symm, hd.2⟩

